<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_bg"
    android:elevation="12dp">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#1e1e1e"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HITBOX EXPANDER BASIC"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <ImageButton
            android:id="@+id/btnClosePanel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#aaaaaa"/>
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#282828"
        android:padding="14dp">

        <!-- Factor input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Factor of Expander:"
                android:textColor="#cccccc"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/inputFactor"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:text="1.5"
                android:inputType="numberDecimal"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/input_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"/>
        </LinearLayout>

        <!-- Part spinner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Part:"
                android:textColor="#cccccc"
                android:textSize="13sp"/>

            <Spinner
                android:id="@+id/spinnerPart"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:backgroundTint="#3c3c3c"/>
        </LinearLayout>

        <!-- Activate / Reset buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnActivate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="▶ Activate Hitbox"
                android:textColor="#001a0a"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#00e676"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="↺ Reset Hitbox"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#ff3d5a"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Log -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/log_bg">
            <TextView
                android:id="@+id/txtLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#7a9cbf"
                android:textSize="10sp"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.4"/>
        </ScrollView>

        <!-- Stop service -->
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:text="✕  Close Panel &amp; Stop Service"
            android:textColor="#888888"
            android:textSize="11sp"
            android:backgroundTint="#1e1e1e"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>
